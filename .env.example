# ----------------------------------------------------------------------
# Copy this file to ".env" and adjust the values before deploying.
#   cp .env.example .env
# ----------------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=todolist
POSTGRES_USER=todolist
# CHANGE THIS to a strong password (required, no default).
POSTGRES_PASSWORD=todolist

# Public HTTP port exposed by Nginx on the VPS
HTTP_PORT=80

# Comma-separated list of origins allowed to call the API (use your
# frontend domain in production, e.g. https://app.example.com).
APP_CORS_ALLOWED_ORIGINS=*

# JVM options for the application container
JAVA_OPTS=-Xms256m -Xmx512m
